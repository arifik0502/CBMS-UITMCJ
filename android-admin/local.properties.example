# Copy to local.properties (git-ignored). Android Studio adds sdk.dir automatically.
supabase.url=https://YOUR-PROJECT-REF.supabase.co
supabase.anonKey=YOUR-ANON-PUBLIC-KEY
# Optional: restricts which account may sign in on this build (the server OWNER check still applies).
developer.email=you@example.com
