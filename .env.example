# Copy to .env.local for local dev. In Cloudflare Pages set these under Settings > Variables and Secrets.
# The anon key is a PUBLIC key by design (protected by RLS/RPC). NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
